@model IEnumerable<ExplorersDream.Models.Product>

@{
    var isAdmin = ViewBag.IsAdmin;
    ViewData["Title"] = "Продукти";
}

<link rel="stylesheet" href="~/css/Index.css" />

<div class="index-container">
    <form method="get" action="@Url.Action("Index")">
        <div class="d-flex mb-3 align-items-center index-structure">
            <div class="index-input-group">
                <span class="index-input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="searchQuery" class="index-form-control" placeholder="Търсене на продукт..."
                       value="@ViewBag.SearchQuery" aria-label="Търсене на продукт...">
            </div>
            <div class="index-buttons">
                <button type="submit" class="index-btn index-btn-primary me-2 index-btn-fixed">Търсене</button>
                <button class="index-btn index-btn-secondary align-items-center index-btn-fixed" type="button" data-bs-toggle="collapse" data-bs-target="#filterMenu">
                    <i class="bi bi-sliders me-2"></i> Филтри
                </button>
            </div>
        </div>

        <div class="collapse" id="filterMenu">
            <div class="index-filter-card shadow-sm">
                <div class="mb-3">
                    <label for="category" class="index-form-label">Категория</label>
                    <select id="category" name="category" class="index-form-select border-input">
                        <option value="">Всички</option>
                        @foreach (var category in ViewBag.Categories)
                        {
                            bool isSelected = ViewBag.SelectedCategory != null && ViewBag.SelectedCategory == category.Id;
                                <option value="@category.Id" selected="@(isSelected ? "selected" : null)">@category.Name</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label for="minPrice" class="index-form-label">Минимална цена</label>
                    <input type="number" step="0.01" id="minPrice" name="minPrice" class="index-form-control"
                           value="@(ViewBag.MinPrice != null ? ViewBag.MinPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                           min="0" />
                </div>
                <div class="mb-3">
                    <label for="maxPrice" class="index-form-label">Максимална цена</label>
                    <input type="number" step="0.01" id="maxPrice" name="maxPrice" class="index-form-control"
                           value="@(ViewBag.MaxPrice != null ? ViewBag.MaxPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "")"
                           min="0" />
                </div>
                <div class="d-flex justify-content-between mt-4 gap-4">
                    <button type="submit" class="index-btn index-btn-success">
                        <i class="bi bi-check-circle me-2"></i> Приложи филтрите
                    </button>
                    <a href="@Url.Action("Index")" class="index-btn index-btn-secondary">Изчисти филтрите</a>
                </div>
            </div>
        </div>

        <h1 class="text-center mt-5 mb-5">Списък с продукти</h1>
    </form>

    @if (isAdmin)
    {
        <form asp-controller="Product" asp-action="Create" method="get">
            <button type="submit" class="index-btn index-btn-success">Добави нов продукт</button>
        </form>
    }

    <div class="index-ь ">
        <div class="row g-4">
            @foreach (var product in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-4" style="width: 100%;">
                    <div class="index-card" onclick="location.href='@Url.Action("Details", "Product", new { id = product.Id })'">
                    @if (product.Images != null && product.Images.Any())
                    {
                        <img src="@product.Images.First().Url" class="index-card-img-top" alt="@product.Name" />
                    }
                    else
                    {
                        <img src="/images/default-product.jpg" class="index-card-img-top" alt="Default Image" />
                    }
                        
                        <div class="index-card-body">
                            <h5 class="index-card-title">@product.Name</h5>
                            <p class="index-card-text">@product.ShortDescription</p>
                            <p class="index-card-text price">@product.Price лв.</p>
                            <div class="index-d-flex">
                            @if (isAdmin)
                            {
                                <a asp-action="Edit" asp-route-id="@product.Id" class="index-btn btn-warning index-btn-fixed" style="color: black">Редактирай</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="index-btn btn-danger index-btn-fixed">Изтрий</a>
                            }
                            else
                            {
                                <form method="post" action="@Url.Action("AddToCart", "Cart")">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="productName" value="@product.Name" />
                                    <input type="hidden" name="imageUrl" value="@(product.Images != null && product.Images.Any() ? product.Images.First().Url : "/images/default-product.jpg")" />
                                    <input type="hidden" name="price" value="@product.Price" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="categoryId" value="@product.CategoryID" />
                                    <button type="submit" class="index-btn index-btn-primary" style="width: 100%;">
                                        <i class="bi bi-cart me-2"></i>Добави в количката
                                    </button>
                                </form>
                            }  
                            </div>
                        </div>  
                    </div>
                </div>
            }
        </div>
    </div>
</div>
