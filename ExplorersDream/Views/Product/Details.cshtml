@model ExplorersDream.Models.Product

@{
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/site.css" />

<div class="container">
    <div class="product-card">
        <!-- Продуктова снимка -->
        <div class="product-image">
            <img src="@Model.Images.FirstOrDefault()?.Url" alt="@Model.Name" />
        </div>

        <!-- Продуктова информация -->
        <div class="product-info">
            <h2>@Model.Name</h2>
            <p><strong>Описание:</strong> @Model.Description</p>
            <p class="price">Цена: @Model.Price лв.</p>


            <div class="size-wrapper">
                @if (Model.CategoryID == 1 || Model.CategoryID == 2)
                {
                    <label class="size-label" for="size">
                        @(Model.CategoryID == 1 ? "Изберете размер:" : "Изберете номер:")
                    </label>
                    <select id="size" class="size-select">
                        @if (Model.CategoryID == 1) // Облекло
                        {
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>
                            <option value="XXXL">XXXL</option>
                        }
                        else if (Model.CategoryID == 2) // Обувки
                        {
                            @for (int size = 35; size <= 48; size++)
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    </select>
                }
            </div>

            <div class="product-actions">
                    <div class="quantity-wrapper">
                        <button type="button" class="quantity-btn" id="decrease">-</button>
                        <input type="number" id="quantity" name="quantity" min="1" value="1" class="quantity-input">
                        <button type="button" class="quantity-btn" id="increase">+</button>
                    </div>
                <a href="#" class="btn btn-primary">
                    <i class="bi bi-cart me-2"></i> Добави в количката
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let quantityInput = document.getElementById("quantity");
        let increaseBtn = document.getElementById("increase");
        let decreaseBtn = document.getElementById("decrease");

        increaseBtn.addEventListener("click", function () {
            quantityInput.value = parseInt(quantityInput.value) + 1;
        });

        decreaseBtn.addEventListener("click", function () {
            if (parseInt(quantityInput.value) > 1) {
                quantityInput.value = parseInt(quantityInput.value) - 1;
            }
        });
    });
</script>
