@model ExplorersDream.Models.Product

<div class="container mt-4">
    <h2>@Model.Name</h2>
    <img src="@Model.Images.FirstOrDefault()?.Url" class="img-fluid" alt="@Model.Name">
    <p class="mt-3"><strong>Цена:</strong> @Model.Price лв.</p>
    <p><strong>Описание:</strong> @Model.Description</p>
    <a asp-action="Index" class="btn btn-secondary btn-fixed">Отказ</a>
</div>
