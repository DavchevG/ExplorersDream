@model ExplorersDream.Models.Product

@{
    ViewData["Title"] = "Добави нов продукт";
}

<style>
    body {
        background-color: #D6FFFF;
        font-family: 'Arial', sans-serif;
    }

    .border-input {
        border-width: 1px;
        border-color: black;
    }

    .btn-fixed {
        min-width: 120px;
    }

    .card {
        background-color: #8FE4E2;
        border-width: 1px;
        border-color: black;
        border-radius: 20px;
    }

</style>

<div class="container mt-5 mb-5" style="max-width: 900px;">
    <div class="card shadow-lg p-4">
        <h1 class="text-center">Добави нов продукт</h1>
        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Име на продукта</label>
                <input asp-for="Name" class="form-control border-input" placeholder="Въведете име" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Описание</label>
                <textarea asp-for="Description" class="form-control border-input" rows="3" placeholder="Въведете описание"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-bold">Цена</label>
                <input asp-for="Price" type="number" step="1" class="form-control border-input" placeholder="Въведете цена" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3 position-relative">
                <label asp-for="CategoryID" class="form-label fw-bold">Категория</label>
                <div class="input-group">
                    <select asp-for="CategoryID" class="form-control border-input" asp-items="@(new SelectList(ViewBag.Categories, "Id", "Name"))">
                        <option value="" disabled selected hidden>Изберете категория</option>
                    </select>
                    <span class="input-group-text border-input"><i class="bi bi-chevron-down"></i></span>
                </div>
                <span asp-validation-for="CategoryID" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="imageFiles" class="form-label fw-bold">Качи снимки</label>
                <input type="file" id="imageFiles" name="imageFiles" class="form-control border-input" multiple />
                <span class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-success btn-fixed px-4">
                    <i class="bi bi-check-circle me-2"></i>Запази
                </button>
                <a asp-action="Index" class="btn btn-secondary btn-fixed">Отказ</a>
            </div>
        </form>
    </div>
</div>
