@model ExplorersDream.Models.Product

<style>
    body {
        background-color: #D6FFFF;
        font-family: 'Arial', sans-serif;
    }

    .delete-card {
        max-width: 600px;
        background-color: #fff3f3;
        border-left: 8px solid #dc3545;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease-in-out, opacity 0.3s ease-in-out;
    }

        .delete-card h1 {
            color: #dc3545;
            font-weight: bold;
        }

        .delete-card .delete-icon {
            font-size: 50px;
            color: #dc3545;
        }

        .delete-card .delete-content {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .delete-card .product-img {
            max-width: 120px;
            border-radius: 8px;
            border: 1px solid #ccc;
        }   

    .fade-out {
        opacity: 0;
        transform: scale(0.9);
    }

    .btn-fixed {
        min-width: 120px;
    }

</style>

<div class="container d-flex justify-content-center" style="margin-top: 100px; margin-bottom: 100px;">
    <div id="deleteBox" class="delete-card">
        <div class="text-center">
            <i class="bi bi-exclamation-triangle delete-icon"></i>
            <p class="fs-5">Наистина ли искате да изтриете този продукт?</p>
        </div>

        <div class="delete-content mt-3">
            @if (Model.Images != null && Model.Images.Any())
            {
                <img src="@Model.Images.First().Url" alt="Продуктово изображение" class="product-img">
            }

            <div>
                <h3 class="fw-bold">@Model.Name</h3>
                <p class="text-right" style="text-align: justify;">@Model.Description</p>
                <p class="fw-bold fs-5">Цена: <span class="text-success">@Model.Price лв.</span></p>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="mt-4 text-center">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger btn-fixed" onclick="fadeOutCard()">Изтрий</button>
            <a asp-action="Index" class="btn btn-secondary btn-fixed">Отказ</a>
        </form>
    </div>
</div>

<script>
    function fadeOutCard() {
        document.getElementById('deleteBox').classList.add('fade-out');
        setTimeout(() => {
            document.getElementById('deleteBox').remove();
        }, 300);
    }
</script>
