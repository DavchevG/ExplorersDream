@model ExplorersDream.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<link rel="stylesheet" href="~/css/Delete.css" />

<div class="container d-flex justify-content-center" style="margin-top: 100px; margin-bottom: 100px;">
    <div id="deleteBox" class="delete-card">
        <div class="text-center">
            <i class="bi bi-exclamation-triangle delete-icon"></i>
            <p class="fs-5">Наистина ли искате да изтриете този продукт?</p>
        </div>

        <div class="delete-content mt-3">
            @if (Model.Images != null && Model.Images.Any())
            {
                <img src="@Model.Images.First().Url" alt="Продуктово изображение" class="product-img">
            }

            <div>
                <h3 class="fw-bold">@Model.Name</h3>
                <p class="fw-bold fs-5">Цена: <span class="text-success">@Model.Price лв.</span></p>
            </div>
        </div>

        <form asp-action="DeleteConfirmed" method="post" class="buttons mt-4 text-center">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger btn-fixed" onclick="fadeOutCard()">Изтрий</button>
            <a asp-action="Index" class="btn btn-secondary btn-fixed">Отказ</a>
        </form>
    </div>
</div>

<script>
    function fadeOutCard() {
        document.getElementById('deleteBox').classList.add('fade-out');
        setTimeout(() => {
            document.getElementById('deleteBox').remove();
        }, 300);
    }
</script>