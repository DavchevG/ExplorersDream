@{
    ViewData["Title"] = "Плащане";
}

<link rel="stylesheet" href="~/css/Checkout.css" asp-append-version="true" />

<div class="payment-container">
    <h2>Въведете информация за доставка</h2>

    <form id="user-info-form" onsubmit="showPaymentOptions(event)">
        <div>
            <label for="name">Име:</label>
            <input type="text" id="name" name="name" required>
        </div>
        <div>
            <label for="email">Имейл:</label>
            <input type="text" id="email" name="email" required>
        </div>
        <div>
            <label for="city">Град:</label>
            <input type="text" id="city" name="city" required>
        </div>
        <div>
            <label for="address">Адрес:</label>
            <input type="text" id="address" name="address" required>
        </div>
        <div>
            <label for="postcode">Пощенски код:</label>
            <input type="text" id="postcode" name="postcode" required>
        </div>
        <div>
            <label for="phone">Телефон:</label>
            <input type="text" id="phone" name="phone" required>
        </div>
        <button type="submit">Продължи към плащане</button>
    </form>

    <!-- Контейнер с методи за плащане, който ще се показва след натискане на бутона -->
    <div id="payment-options">

        <div>
            <button id="checkout-button">Плати с карта</button>
        </div>

        <div>
            <div id="paypal-button-container"></div>
        </div>
    </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
    // Инициализиране на Stripe
    var stripe = Stripe("pk_test_51R4224R4OJ4KW8TRfG9jHQcyCU1XzDGFeRWSUOeiRcWBqX2lf1wIAnSXyUMAmnlJkT03h0qc9X8LdkH0X8ugfOzd00rxbHhcm9");

    function showPaymentOptions(event) {
        event.preventDefault();
        document.getElementById('payment-options').style.display = 'flex';
        document.getElementById('user-info-form').querySelector('button[type="submit"]').style.display = 'none';
    }
        
    // За Stripe
    document.getElementById("checkout-button").addEventListener("click", function () {
        fetch("/Stripe/CreateCheckoutSession", { method: "POST" })
            .then(response => response.json())
            .then(session => {
                return stripe.redirectToCheckout({ sessionId: session.id });
            })
            .catch(error => console.error("Грешка:", error));
    });
</script>

<script src="https://www.paypal.com/sdk/js?client-id=AeqjWtnbbny07wGlhGLbTIMpB_ZEyzmvnGBCW_-bDgfMdU61VIVXi7pq_c6xYwOi4s9CMtGEOPPzH9w7&components=buttons,funding-eligibility&currency=USD"></script>

<script>
    paypal.Buttons({
    style: {
        borderRadius: 15,
        height: 48,
    },
    fundingSource: paypal.FUNDING.PAYPAL,
    createOrder: function (data, actions) {
        return fetch("/PayPal/CreatePayPalOrder", { method: "POST" })
            .then(response => response.json())
            .then(orderDetails => {
                return actions.order.create({
                    purchase_units: [{
                        amount: {
                            value: orderDetails.totalInUsd.toString() 
                        }
                    }],
                });
            });
    },
    onApprove: function (data, actions) {
        return actions.order.capture().then(function (details) {
            alert('Плащането беше успешно! ' + details.payer.name.given_name);
            window.location.href = "/Home/OrderSuccess";
        });
    },
    onError: function (err) {
        alert('Грешка при плащането.');
        console.error('PayPal Error:', err);
        window.location.href = "/Cart/Checkout";
    }
}).render('#paypal-button-container');

</script>
