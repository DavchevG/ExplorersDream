@{
    ViewData["Title"] = "Плащане с карта";
}

<h2>Плащане</h2>
<p>Моля, натиснете бутона, за да продължите към Stripe Checkout.</p>

<button id="checkout-button">Плати с карта</button>

<script src="https://js.stripe.com/v3/"></script>
<script>
    var stripe = Stripe("pk_test_51R4224R4OJ4KW8TRfG9jHQcyCU1XzDGFeRWSUOeiRcWBqX2lf1wIAnSXyUMAmnlJkT03h0qc9X8LdkH0X8ugfOzd00rxbHhcm9"); // Вземи публичния ключ от appsettings.json

    document.getElementById("checkout-button").addEventListener("click", function () {
        fetch("/Stripe/CreateCheckoutSession", { method: "POST" })
            .then(response => response.json())
            .then(session => {
                return stripe.redirectToCheckout({ sessionId: session.id });
            })
            .then(result => {
                if (result.error) {
                    alert(result.error.message);
                }
            })
            .catch(error => console.error("Грешка:", error));
    });
</script>
